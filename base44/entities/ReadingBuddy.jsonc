{
  "name": "ReadingBuddy",
  "type": "object",
  "properties": {
    "user1Id": {
      "type": "string",
      "description": "User who sent the buddy invite"
    },
    "user2Id": {
      "type": "string",
      "description": "User who was invited"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted"
      ],
      "default": "pending"
    },
    "planId": {
      "type": "string",
      "description": "Inviter's reading plan shared with the buddy, if any"
    },
    "planName": {
      "type": "string",
      "description": "Name of the shared plan at invite time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user1Id",
    "user2Id",
    "status"
  ],
  "rls": {
    "create": false,
    "update": false,
    "delete": false,
    "read": {
      "data.user1Id": "{{user.id}}"
    }
  }
}
